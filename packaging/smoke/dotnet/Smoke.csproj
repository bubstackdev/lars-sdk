<Project Sdk="Microsoft.NET.Sdk">
  <!-- Install test for the NuGet package: restores Moedex.Lars from a local feed (LarsFeed), with no
       LARS_NATIVE, so the native library must come from the package's runtimes/ folder. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestoreAdditionalProjectSources>$(LarsFeed)</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Moedex.Lars" Version="0.1.0-rc.1" />
  </ItemGroup>
</Project>
